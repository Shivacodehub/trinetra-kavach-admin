# Copy to .env  (cp .env.example .env). NEVER commit .env.
ENVIRONMENT=development

# --- PostgreSQL (local Docker container) ---
POSTGRES_USER=trinetra
POSTGRES_PASSWORD=trinetra_dev_password
POSTGRES_DB=trinetra_kavach

# Used when running FastAPI OUTSIDE Docker (host -> container port 5432).
# Inside docker compose this is overridden to point at the "postgres" service.
DATABASE_URL=postgresql+psycopg://trinetra:trinetra_dev_password@localhost:5432/trinetra_kavach

# --- Auth ---
# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-replace-me-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REMEMBER_ME_MINUTES=10080

# --- CORS (comma separated, explicit origins only) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo seed credentials (used only by `python -m app.seed`) ---
SEED_ADMIN_EMAIL=admin@trinetra.local
SEED_ADMIN_PASSWORD=Demo@12345

# --- Phase 2 ---
# Base URL of the React app. Certificate QR codes encode  <PUBLIC_BASE_URL>/verify/<certificate_id>.
# For phone-scan demos set this to your laptop LAN IP, e.g. http://192.168.1.10:5173
PUBLIC_BASE_URL=http://localhost:5173
WORKER_TOKEN_MINUTES=10080
# 0 = certificates never expire. Set only if your safety experts define a validity period.
CERTIFICATE_VALIDITY_DAYS=0
# Demo PIN given to seeded workers (Unity login: worker_code + PIN)
SEED_WORKER_PIN=123456
